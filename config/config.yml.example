# Copy this as config.yml and supply the DB password

# Server configurations
server:
  host: "localhost"
  port: ":8090"
  origin: "http://localhost:8280"

# Database credentials
database:
  host: "localhost"
  port: "3306"
  user: "dm_tool"
  pass: "PASSWORD"
  db: "dm_campaign_manager"
  driver: "mysql"

# JWT encryption key
jwt:
  secret: "CHANGE_ME"
